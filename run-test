#!/usr/bin/env bash
# run-test - 在 bin 目录下运行 ctest（适配 msys2 clang64 终端环境）
#
# 用法（参照 gels 的 run-tests 模式）:
#   ./run-test                  # 默认: 本地测试（sqlitemem 内存库 + json 文件库加固）
#   ./run-test <name>...        # 按名字选择: sqlitemem | sqlite | json | mysql | pg | dm
#                               #            sqliteplain | mysqlplain | pgplain | dmplain
#                               # 可组合: ./run-test sqlitemem sqlite json
#   ./run-test local            # 本地: sqlitemem + sqlite(文件) + json(文件) + jsonfile 加固
#   ./run-test remote           # 远程数据库: mysql + pg + dm
#   ./run-test all              # 全部
#   其余参数透传给 ctest，如: ./run-test -V 或 ./run-test json -R test_contract_jsonfile
#
# 名字与测试目标的对应关系 (config-driven suite):
#   sqlitemem -> test_contract_sqlite3_mem   (内存型 SQLite)
#   sqlite    -> test_contract_sqlite3       (文件型 SQLite)
#   json      -> test_contract_jsonfile + test_jsonfile (JSON 文件型契约 + 加固)
#   mysql     -> test_contract_mysql
#   pg        -> test_contract_postgres
#   dm        -> test_contract_dm8
#   jsonfile-hardening -> test_jsonfile (文件型后端加固测试)
#   utils     -> test_dbutils (后端无关的 DbUtils / DbBase 门面单测)
#   pool      -> test_pool (HandlePool 连接池租约/自愈单测)
#   sqliteplain -> test_contract_sqlite3_mem_plain  (parameterized=false)
#   mysqlplain  -> test_contract_mysql_plain        (parameterized=false)
#   pgplain     -> test_contract_postgres_plain     (parameterized=false)
#   dmplain     -> test_contract_dm8_plain          (parameterized=false)

# 脚本所在目录（项目根），并规范化为 POSIX 风格路径：
# 当从 Windows 风格的工作目录启动时 pwd 会给出 "D:/x/y"，该形式拼入 MSYS 的
# PATH 后无法被转换为 Windows 搜索路径，导致测试进程找不到 DLL（0xc0000135）。
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SCRIPT_DIR="${SCRIPT_DIR//\\//}"
case "$SCRIPT_DIR" in
    [A-Za-z]:*) SCRIPT_DIR="/$(echo "$SCRIPT_DIR" | cut -c1 | tr 'A-Z' 'a-z')${SCRIPT_DIR:2}" ;;
esac
BIN_DIR="$SCRIPT_DIR/bin"
BUILD_DIR="$SCRIPT_DIR/build"

# 1) 可执行文件依赖 thirds/bin/win10 下的 DLL（sqlite3.dll, libmysql.dll, libpq.dll, dmdpi.dll 等）
# 2) msys2 clang64 编译的可执行文件还依赖 UCRT 运行库（api-ms-win-crt-*.dll）
export PATH="$SCRIPT_DIR/thirds/bin/win10:$PATH"

if [ ! -d "$BIN_DIR" ]; then
    echo "错误: 未找到 bin 目录 ($BIN_DIR)，请先执行 cmake --build build 完成构建。" >&2
    exit 1
fi

# 解析参数: 已知名字收集为测试目标，其余透传给 ctest
NAMES=()
PASSTHROUGH=()
for arg in "$@"; do
    case "$arg" in
        sqlitemem|sqlite|json|mysql|pg|dm|sqliteplain|mysqlplain|pgplain|dmplain|utils|pool|local|remote|all)
            NAMES+=("$arg") ;;
        -*)
            PASSTHROUGH+=("$arg") ;;
        *)
            echo "警告: '$arg' 不是有效的测试名（sqlitemem|sqlite|json|mysql|pg|dm|sqliteplain|mysqlplain|pgplain|dmplain|utils|pool|local|remote|all），将原样传给 ctest。" >&2
            PASSTHROUGH+=("$arg") ;;
    esac
done

# 名字 -> ctest 测试正则
map_name() {
    case "$1" in
        sqlitemem)         echo "test_contract_sqlite3_mem" ;;
        sqliteplain)       echo "test_contract_sqlite3_mem_plain" ;;
        mysqlplain)        echo "test_contract_mysql_plain" ;;
        pgplain)           echo "test_contract_postgres_plain" ;;
        dmplain)           echo "test_contract_dm8_plain" ;;
        sqlite)            echo "test_contract_sqlite3" ;;
        json|jsonfile)     echo "test_contract_jsonfile|test_jsonfile" ;;
        mysql)             echo "test_contract_mysql" ;;
        pg|postgres)       echo "test_contract_postgres" ;;
        dm|dm8)            echo "test_contract_dm8" ;;
        utils)             echo "test_dbutils" ;;
        pool)              echo "test_pool" ;;
        *)                 return 1 ;;
    esac
}

REGEX=""
SELECTED=()
if [ ${#NAMES[@]} -eq 0 ]; then
    # 默认: 内存型 sqlite + json 文件库加固，不需要数据库服务器
    SELECTED=(test_contract_sqlite3_mem test_jsonfile test_dbutils test_pool)
else
    for n in "${NAMES[@]}"; do
        if [ "$n" = "all" ]; then
            SELECTED=()   # 空 = 不加 -R，跑全部
            break
        fi
        if [ "$n" = "local" ]; then
            SELECTED+=(test_contract_sqlite3_mem test_contract_sqlite3 test_contract_jsonfile test_jsonfile test_dbutils test_pool)
            continue
        fi
        if [ "$n" = "remote" ]; then
            SELECTED+=(test_contract_mysql test_contract_postgres test_contract_dm8)
            continue
        fi
        t=$(map_name "$n") || t="$n"
        SELECTED+=("$t")
    done
fi

# 去重（保持顺序）
UNIQ=()
for t in "${SELECTED[@]}"; do
    dup=0
    for u in "${UNIQ[@]}"; do
        [ "$u" = "$t" ] && dup=1 && break
    done
    [ $dup -eq 0 ] && UNIQ+=("$t")
done

# 组装 ctest 命令
CMD=(ctest --test-dir "$BUILD_DIR" --output-on-failure)
if [ ${#UNIQ[@]} -gt 0 ]; then
    REGEX=$(IFS='|'; echo "${UNIQ[*]}")
    CMD+=(-R "$REGEX")
fi
CMD+=("${PASSTHROUGH[@]}")

# ctest 测试注册表在构建目录中，用 --test-dir 指向 build
# --output-on-failure 便于失败时直接看到断言输出
cd "$BIN_DIR" || exit 1
exec "${CMD[@]}"
